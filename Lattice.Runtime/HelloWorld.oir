module Program version 1.0.0

class Program {
    static method fact(n: int32) -> int32 {
        local acc: int32

        // #line 8:24 "var acc: int = 1;"
        ldc.i4 1
        // #line 8:24 "var acc: int = 1;"
        stloc acc
        // #line 9:15 "while(n > 1)"
        ldarg 0
        // #line 9:19 "while(n > 1)"
        ldc.i4 1
        // #line 9:19 "while(n > 1)"
        cgt
        // #line 9:19 "while(n > 1)"
        while (stack) {
            // #line 11:19 "acc = acc * n;"
            ldloc acc
            // #line 11:25 "acc = acc * n;"
            ldarg 0
            // #line 11:25 "acc = acc * n;"
            mul
            // #line 11:25 "acc = acc * n;"
            stloc acc
            // #line 12:17 "n = n -1;"
            ldarg 0
            // #line 12:20 "n = n -1;"
            ldc.i4 1
            // #line 12:20 "n = n -1;"
            sub
            // #line 12:20 "n = n -1;"
            starg 0
        }
        // #line 14:16 "return acc;"
        ldloc acc
        // #line 14:16 "return acc;"
        ret
    }

    static method Main(args: string[]) -> void {
        local n: int32
        local acc: int32

        // #line 20:20 "IO.Println("hello world");"
        ldstr "hello world"
        // #line 20:20 "IO.Println("hello world");"
        call IO.Println(string) -> void
        // #line 21:22 "var n: int = 50;"
        ldc.i4 50
        // #line 21:22 "var n: int = 50;"
        stloc n
        // #line 22:24 "var acc: int = 1;"
        ldc.i4 1
        // #line 22:24 "var acc: int = 1;"
        stloc acc
        // #line 23:15 "while(n > 1)"
        ldloc n
        // #line 23:19 "while(n > 1)"
        ldc.i4 1
        // #line 23:19 "while(n > 1)"
        cgt
        // #line 23:19 "while(n > 1)"
        while (stack) {
            // #line 25:19 "acc = acc * n;"
            ldloc acc
            // #line 25:25 "acc = acc * n;"
            ldloc n
            // #line 25:25 "acc = acc * n;"
            mul
            // #line 25:25 "acc = acc * n;"
            stloc acc
            // #line 26:17 "n = n -1;"
            ldloc n
            // #line 26:20 "n = n -1;"
            ldc.i4 1
            // #line 26:20 "n = n -1;"
            sub
            // #line 26:20 "n = n -1;"
            stloc n
        }
        // #line 23:19 "while(n > 1)"
        ret
    }
}

class Utils {
    method utils_func() -> int32 {
        // #line 6:16 "static fn fact(n)"
        ldstr "Hello from Utils!"
        // #line 6:16 "static fn fact(n)"
        call IO.Println(string) -> void
        // #line 6:16 "static fn fact(n)"
        ldc.i4 0
        // #line 6:16 "static fn fact(n)"
